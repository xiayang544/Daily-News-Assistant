# ===== LLM（必填）=====
DEEPSEEK_API_KEY=
# ===== 联网搜索（必填，二选一）=====
SEARCH_PROVIDER=tavily
TAVILY_API_KEY=
BRAVE_API_KEY=
# ===== 邮件推送（正式环境 SMTP；开发环境可用 Mailpit）=====
# Mailpit 本地模拟: docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Daily News Assistant <news@example.com>
SMTP_STARTTLS=0
# ===== 服务配置 =====
SCHEDULE_HOUR=8
DEFAULT_TIMEZONE=Asia/Shanghai
AGENT_MAX_ITERATIONS=12
AGENT_TIME_BUDGET=300
