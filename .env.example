# ===== LLM（必填）=====
# DeepSeek API Key: https://platform.deepseek.com/
DEEPSEEK_API_KEY=sk-xxx

# ===== 联网搜索（必填，二选一）=====
# 搜索提供商: tavily | brave
SEARCH_PROVIDER=tavily
# Tavily API Key（免费注册，每月 1000 次额度）: https://tavily.com/
TAVILY_API_KEY=tvly-xxx
# Brave Search API Key（可选替代）: https://brave.com/search/api/
BRAVE_API_KEY=

# ===== 推送渠道（可选，不配则只在 Web 页面查看）=====
# 推送渠道: dingtalk | feishu | wecom
PUSH_CHANNEL=dingtalk
# 机器人 Webhook 地址
PUSH_WEBHOOK_URL=
# 钉钉机器人加签密钥（仅钉钉开启"加签"安全设置时需要）
DINGTALK_SECRET=

# ===== 服务配置 =====
# 每天几点生成简报（0-23）
SCHEDULE_HOUR=8
# SQLite 数据库文件路径
DB_PATH=data/news.db
